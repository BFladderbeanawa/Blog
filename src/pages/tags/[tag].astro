---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import BlogNav from '../../components/BlogNav.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat().filter(Boolean))];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) => post.data.tags?.includes(tag));
    return { params: { tag }, props: { posts: filteredPosts } };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`Tag: ${tag}`}>
  <main class="page-shell">
    <BlogNav tags={[tag]} />
    <a class="back-link" href={`/tags?tags=${tag}`}>Open tag explorer</a>
    <h1 class="page-title">#{tag}</h1>
    <div class="registry-head" aria-hidden="true">
      <span>REC</span>
      <span>Date</span>
      <span>Record</span>
      <span>Category</span>
      <span></span>
    </div>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} highlightTags={[tag]} />)}
    </div>
  </main>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    margin-bottom: var(--space-md);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
