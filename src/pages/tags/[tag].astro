---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import BlogNav from '../../components/BlogNav.astro';
import { Button } from '@/components/ui/button';
import { Card } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat().filter(Boolean))];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) => post.data.tags?.includes(tag));
    return { params: { tag }, props: { posts: filteredPosts } };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`Tag: ${tag}`}>
  <main class="page-shell">
    <Button variant="ghost" asChild className="p-0 h-auto back-link">
      <a href={`/tags?tags=${tag}`}>Open tag explorer</a>
    </Button>
    <Card className="tag-heading-card editorial-frame rounded-none border-0 shadow-none mb-6">
      <div class="flex items-center justify-between gap-4">
        <h1 class="page-title m-0">#{tag}</h1>
        <Badge variant="default" className="rounded-none font-mono text-xs uppercase px-2 py-1">{posts.length} records</Badge>
      </div>
    </Card>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} highlightTags={[tag]} />)}
    </div>
  </main>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    margin-bottom: var(--space-md);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
