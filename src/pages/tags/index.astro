---
import Layout from '../../layouts/Layout.astro';
import BlogNav from '../../components/BlogNav.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat().filter(Boolean))].sort();
const tagCounts = tags.reduce((acc, tag) => {
  if (!tag) return acc;
  acc[tag] = allPosts.filter((p) => p.data.tags?.includes(tag)).length;
  return acc;
}, {} as Record<string, number>);
---

<Layout title="Tags">
  <main class="page-shell">
    <BlogNav />
    <section class="tag-explorer">
      <h1 class="page-title">Tag Filter</h1>
      <div class="tag-controls">
        <div class="tag-filter-header">
          <span class="axis-label">Multi-select tags</span>
          <button id="clear-tags" class="clear-btn" style="display: none;">Clear</button>
        </div>
        <div class="tag-cloud-selector">
          {tags.map((tag) => (
            <button class="tag-toggle-btn" data-tag={tag} aria-pressed="false">
              <span class="tag-name">#{tag}</span>
              <span class="tag-count">{tagCounts[tag]}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="results-header">
        <h2 id="results-count">All records</h2>
      </div>

      <div class="post-grid" id="posts-grid">
        {allPosts.map((post) => (
          <div class="post-item-wrapper" data-tags={JSON.stringify(post.data.tags || [])} style="display: block;">
            <PostCard post={post} highlightTags={[]} />
          </div>
        ))}
      </div>

      <div id="no-results" style="display: none;">
        <p>No records match that tag set.</p>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const tagButtons = document.querySelectorAll('.tag-toggle-btn');
    const postItems = document.querySelectorAll('.post-item-wrapper');
    const clearBtn = document.getElementById('clear-tags');
    const resultsCountHeader = document.getElementById('results-count');
    const noResultsMsg = document.getElementById('no-results');
    let activeTags = new Set();

    const params = new URLSearchParams(window.location.search);
    const urlTags = params.get('tags');
    const legacyTag = params.get('tag');
    if (urlTags) urlTags.split(',').forEach((t) => activeTags.add(t));
    else if (legacyTag) activeTags.add(legacyTag);

    function updateURL() {
      const url = new URL(window.location.href);
      if (activeTags.size > 0) url.searchParams.set('tags', Array.from(activeTags).join(','));
      else url.searchParams.delete('tags');
      window.history.replaceState({}, '', url);
    }

    function updateUI() {
      tagButtons.forEach((btn) => {
        const tag = btn.getAttribute('data-tag');
        const active = tag && activeTags.has(tag);
        btn.classList.toggle('active', Boolean(active));
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      if (clearBtn) clearBtn.style.display = activeTags.size > 0 ? 'inline-block' : 'none';

      let visibleCount = 0;
      const activeTagsList = Array.from(activeTags);
      postItems.forEach((item) => {
        const itemTagSet = new Set(JSON.parse(item.getAttribute('data-tags') || '[]'));
        const matches = activeTags.size === 0 || activeTagsList.every((t) => itemTagSet.has(t));
        item.style.display = matches ? 'block' : 'none';
        if (matches) visibleCount++;

        item.querySelectorAll('.mini-tag').forEach((mt) => {
          const tText = mt.textContent.replace('#', '');
          mt.classList.toggle('highlight', activeTags.has(tText));
        });
      });

      if (resultsCountHeader) resultsCountHeader.textContent = activeTags.size === 0 ? `All records (${visibleCount})` : `Filtered records (${visibleCount})`;
      if (noResultsMsg) noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
      updateURL();
    }

    tagButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag');
        if (!tag) return;
        if (activeTags.has(tag)) activeTags.delete(tag);
        else activeTags.add(tag);
        updateUI();
      });
    });

    clearBtn?.addEventListener('click', () => {
      activeTags.clear();
      updateUI();
    });

    document.querySelector('.post-grid')?.addEventListener('click', (e) => {
      const link = e.target.closest('a');
      if (link) {
        sessionStorage.setItem('blog_nav_context', JSON.stringify({ type: 'tags', data: Array.from(activeTags).join(',') }));
      }
    });

    updateUI();
  });
</script>

<style>
  .tag-controls {
    margin-bottom: var(--space-xl);
    padding: var(--space-lg);
    border: var(--frame) solid var(--border);
    background: var(--surface);
  }

  .tag-filter-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: var(--space-md);
  }

  .clear-btn,
  .tag-toggle-btn {
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .clear-btn {
    padding: 0.3rem 0.5rem;
  }

  .tag-cloud-selector {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-toggle-btn {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.55rem 0.75rem;
  }

  .tag-toggle-btn:hover,
  .tag-toggle-btn.active,
  .clear-btn:hover {
    background: var(--text-primary);
    color: var(--canvas);
  }

  .tag-count {
    opacity: 0.65;
  }

  .results-header h2 {
    margin-bottom: var(--space-lg);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #no-results {
    padding: var(--space-xl);
    border: 1px solid var(--border);
    margin-top: var(--space-xl);
  }
</style>
