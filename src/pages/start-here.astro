---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import featuredSlugs from '../featured-posts.json';

const allPosts = await getCollection('blog');
const normalizeSlug = (slug: string) => slug.toLowerCase().replace(/\s+/g, '-');
const normalizedFeatured = featuredSlugs.map(normalizeSlug);
let featuredPosts = allPosts.filter((post) => normalizedFeatured.includes(normalizeSlug(post.id)));
featuredPosts.sort((a, b) => normalizedFeatured.indexOf(normalizeSlug(a.id)) - normalizedFeatured.indexOf(normalizeSlug(b.id)));

if (featuredPosts.length === 0) {
  featuredPosts = allPosts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
}

const categories = [...new Set(allPosts.map((post) => post.data.category).filter(Boolean))];
---

<Layout title="Start Here" description="A reading guide for new visitors">
  <main class="page-shell start-page">
    <section class="start-hero editorial-frame">
      <span class="axis-label">Start here / orientation</span>
      <h1>Choose a path through the archive.</h1>
      <p>
        This site is less a linear blog and more a working desk. Begin with a category, follow a suggested route, or jump straight into recent records.
      </p>
    </section>

    <section>
      <div class="section-rail">
        <span class="rail-node"></span>
        <span class="axis-label">Topic gates</span>
      </div>
      <div class="category-cloud">
        {categories.map((cat) => <a href={`/category/${cat}`} class="cat-pill">{cat}</a>)}
        <a href="/category" class="cat-pill more">All categories</a>
      </div>
    </section>

    <section>
      <div class="section-rail">
        <span class="rail-node"></span>
        <span class="axis-label">Recommended route</span>
      </div>
      <div class="roadmap-grid">
        <a class="roadmap-card" href="/about">
          <span class="step-number">01</span>
          <h3>Meet the author</h3>
          <p>Understand the person behind the notes before diving into the archive.</p>
        </a>
        <a class="roadmap-card" href="/blog">
          <span class="step-number">02</span>
          <h3>Open the archive</h3>
          <p>Scan the whole record, then switch between expanded and compact reading modes.</p>
        </a>
        <a class="roadmap-card" href="/tags">
          <span class="step-number">03</span>
          <h3>Filter by tags</h3>
          <p>Use tags as cross-wires between math, code, philosophy, and daily fragments.</p>
        </a>
      </div>
    </section>

    <section>
      <div class="section-rail">
        <span class="rail-node"></span>
        <span class="axis-label">Featured records</span>
      </div>
      <div class="post-grid">
        {featuredPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  </main>
</Layout>

<style>
  .start-page {
    display: grid;
    gap: var(--space-3xl);
  }

  .start-hero {
    padding: clamp(1.2rem, 4vw, 3rem);
    background:
      linear-gradient(110deg, var(--accent-orange) 0 22%, transparent 22%),
      var(--surface);
  }

  .start-hero h1 {
    max-width: 12ch;
    margin-top: var(--space-xl);
    font-size: var(--text-3xl);
  }

  .start-hero p {
    max-width: 44rem;
    margin-top: var(--space-lg);
    font-size: clamp(1rem, 2vw, 1.3rem);
  }

  .category-cloud,
  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-md);
  }

  .cat-pill,
  .roadmap-card {
    border: 1px solid var(--border);
    background: var(--surface);
    padding: var(--space-lg);
  }

  .cat-pill {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .cat-pill:hover,
  .roadmap-card:hover {
    background: var(--text-primary);
    color: var(--canvas);
  }

  .cat-pill.more {
    background: rgb(var(--accent));
    color: #fffef8;
  }

  .roadmap-card {
    position: relative;
    min-height: 18rem;
    display: grid;
    align-content: end;
    overflow: hidden;
  }

  .step-number {
    position: absolute;
    top: -0.6rem;
    right: 0.6rem;
    color: var(--text-ghost);
    font-family: var(--font-display);
    font-size: 8rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.08em;
  }

  .roadmap-card h3 {
    position: relative;
    font-size: clamp(1.7rem, 4vw, 3rem);
  }

  .roadmap-card p {
    position: relative;
    margin-top: var(--space-md);
  }

  .roadmap-card:hover p,
  .roadmap-card:hover .step-number {
    color: var(--canvas);
  }
</style>
