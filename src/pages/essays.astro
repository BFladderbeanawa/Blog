<style>
  .essays-page {
    display: grid;
    gap: var(--space-3xl);
  }

  .essays-hero {
    padding: clamp(1.2rem, 4vw, 3rem);
    background:
      linear-gradient(100deg, var(--accent-sky) 0 18%, transparent 18%),
      var(--surface);
  }

  .essays-hero h1 {
    max-width: 13ch;
    margin: var(--space-xl) 0;
    font-size: var(--text-3xl);
  }

  .essays-hero p {
    max-width: 56rem;
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  .download-link {
    display: inline-flex;
    width: fit-content;
    margin-top: var(--space-lg);
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border);
    background: var(--text-primary);
    color: var(--canvas);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .essay-card {
    display: grid;
    grid-template-columns: minmax(16rem, 0.35fr) minmax(0, 0.65fr);
    border: var(--frame) solid var(--border);
    background: var(--surface);
  }

  .essay-meta {
    position: sticky;
    top: var(--space-lg);
    align-self: start;
    min-height: 24rem;
    padding: var(--space-lg);
    border-right: 1px solid var(--border);
    background: var(--accent-lemon);
  }

  .essay-meta h2 {
    margin-top: var(--space-xl);
    color: #111;
    font-size: clamp(2rem, 6vw, 5rem);
  }

  .essay-meta .axis-label {
    color: #111;
  }

  .essay-content {
    padding: clamp(1rem, 4vw, 3rem);
  }

  .essay-content h3 {
    margin: var(--space-xl) 0 var(--space-md);
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--border);
    font-size: clamp(1.4rem, 3vw, 2.3rem);
  }

  .essay-content h3:first-child {
    margin-top: 0;
  }

  .essay-content p {
    margin: 1rem 0;
    line-height: 1.72;
  }

  .revision-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .revision-grid > div {
    padding: var(--space-md);
    border: 1px solid var(--border);
  }

  .revision-grid strong {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .essay-card,
    .revision-grid {
      grid-template-columns: 1fr;
    }

    .essay-meta {
      position: relative;
      top: auto;
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
