---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import VisitorWidgets from '../components/VisitorWidgets.astro';
import { Card } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestPosts = posts.slice(0, 3);
---

<Layout>
  <main class="home-page page-shell">
    <Card className="hero-panel editorial-frame rounded-none border-0 shadow-none">
      <div class="hero-copy">
        <Badge variant="outline" className="axis-label rounded-none w-fit border-0 p-0">Personal archive / 00-Home</Badge>
        <h1>Notes for things that refuse to stay tidy.</h1>
        <p>
          A digital garden for code, mathematics, philosophy, stray tools, and the little systems that make thinking easier to revisit.
        </p>
      </div>
      <Card className="hero-card rounded-none shadow-none">
        <Badge variant="outline" className="card-kicker rounded-none w-fit border-0 p-0">Current Mode</Badge>
        <strong>Field Notes</strong>
        <p>Drafted in public, revised in motion, indexed for future wandering.</p>
      </Card>
    </Card>

    <section class="latest-section">
      <div class="section-rail">
        <span class="rail-node"></span>
        <span class="axis-label">Latest dispatches</span>
      </div>
      <div class="post-grid">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <section class="route-section">
      <Card className="p-0 border-0 shadow-none rounded-none bg-transparent">
        <a href="/start-here" class="route-card accent-band">
          <Badge variant="outline" className="axis-label rounded-none w-fit border-0 p-0">First visit</Badge>
          <strong>Start with the map</strong>
          <span>Reading guide</span>
        </a>
      </Card>
      <Card className="p-0 border-0 shadow-none rounded-none bg-transparent">
        <a href="/blog" class="route-card">
          <Badge variant="outline" className="axis-label rounded-none w-fit border-0 p-0">Archive</Badge>
          <strong>Open all records</strong>
          <span>Browse posts</span>
        </a>
      </Card>
    </section>
    <section class="stats-section">
      <div class="section-rail">
        <span class="rail-node"></span>
        <span class="axis-label">Visitor telemetry</span>
      </div>
      <VisitorWidgets />
    </section>
  </main>
</Layout>

<style>
  .home-page {
    display: grid;
    gap: var(--space-3xl);
  }

  .hero-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 28rem);
    min-height: min(620px, 72vh);
    padding: clamp(1rem, 4vw, 3rem);
    background:
      linear-gradient(90deg, transparent 0 62%, var(--accent-lemon) 62% 75%, transparent 75%),
      var(--surface);
  }

  .hero-panel::after {
    content: "BF";
    position: absolute;
    right: 0.5rem;
    bottom: -0.2rem;
    color: var(--text-ghost);
    font-family: var(--font-display);
    font-size: clamp(9rem, 28vw, 28rem);
    font-weight: 900;
    line-height: 0.72;
    letter-spacing: -0.09em;
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: space-between;
    gap: var(--space-xl);
  }

  .hero-copy h1 {
    max-width: 11ch;
    font-size: var(--text-4xl);
  }

  .hero-copy p {
    max-width: 42rem;
    font-size: clamp(1rem, 2vw, 1.45rem);
    line-height: 1.35;
  }

  .hero-card {
    position: relative;
    z-index: 1;
    align-self: end;
    padding: var(--space-lg);
    border: 1px solid var(--border);
    background: var(--accent-sky);
    transform: rotate(-2deg);
  }

  .card-kicker {
    color: #111;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-card strong {
    display: block;
    margin: 0.8rem 0;
    color: #111;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }

  .hero-card p {
    color: #111;
  }

  .route-section {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .route-card {
    min-height: 14rem;
    padding: var(--space-lg);
    border: var(--frame) solid var(--border);
    background: var(--surface);
    display: grid;
    align-content: space-between;
  }

  .route-card:hover {
    transform: translate(-0.2rem, -0.2rem);
  }

  .route-card strong {
    max-width: 10ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 7vw, 5rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }

  .route-card span:last-child {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .accent-band .axis-label,
  .accent-band span,
  .accent-band strong {
    color: #fffef8;
  }

  @media (max-width: 900px) {
    .hero-panel,
    .route-section {
      grid-template-columns: 1fr;
    }

    .hero-panel {
      min-height: auto;
    }
  }
</style>
