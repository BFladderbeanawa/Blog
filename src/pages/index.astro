---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import VisitorWidgets from '../components/VisitorWidgets.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestPosts = posts.slice(0, 3);
---

<Layout>
  <main class="home-page page-shell">
    <section class="poster-board" aria-labelledby="home-title">
      <div class="poster-kicker axis-label">知识构成 // 記録編集 // Personal archive / 00</div>

      <div class="red-slab" aria-hidden="true" data-depth="10">BF</div>
      <div class="blue-slab" aria-hidden="true" data-depth="14">構成</div>
      <span class="hero-ghost" aria-hidden="true" data-depth="-8">§</span>

      <header class="poster-title-block" data-depth="6">
        <span class="obs-eyebrow calibrate">OBS.STATION // FIELD NOTES</span>
        <h1 id="home-title" class="kinetic">
          <span class="kw"><span style="--i:0">Construct</span></span>
          <span class="kw"><span style="--i:1">the</span></span>
          <span class="kw kw-accent"><span style="--i:2">untidy</span></span>
          <span class="kw"><span style="--i:3">notes.</span></span>
        </h1>
      </header>

      <aside class="manifesto-block calibrate-2" data-depth="4">
        <span class="axis-label">宣言 // Manifesto // 宣言</span>
        <p>
          A digital garden for code, mathematics, philosophy, stray tools, and the little systems that make thinking easier to revisit.
          知识在这里被切割、重排、再装订。思考はここで組み直される。
        </p>
        <p class="obs-stat">LAT <b>31.23</b> // LON <b>121.47</b> // EST. <b>BF.01</b></p>
      </aside>

      <a href="/start-here" class="poster-route route-start calibrate-3">
        <span>初访入口</span>
        <strong>Start with the map</strong>
        <small>Reading guide ／ 読書地図</small>
      </a>

      <a href="/blog" class="poster-route route-archive calibrate-3">
        <span>文档庫</span>
        <strong>Open all records</strong>
        <small>Browse posts ／ 全記録</small>
      </a>

      <div class="mode-block obs-frame obs-hover">
        <span class="axis-label">Current Mode // 現在信号</span>
        <strong>Field Notes<br />野外記録</strong>
        <p>Drafted in public, revised in motion, indexed for future wandering.</p>
      </div>

      <hr class="obs-ruler" />

      <section class="dispatch-block" aria-labelledby="dispatch-title" data-reveal>
        <div class="block-heading">
          <span id="dispatch-title" class="obs-eyebrow">Latest dispatches // 最新通信 // 新着記録</span>
        </div>
        <div class="post-grid poster-post-grid">
          {latestPosts.map((post) => <PostCard post={post} />)}
        </div>
      </section>

      <hr class="obs-ruler" />

      <section class="telemetry-block" aria-labelledby="telemetry-title" data-reveal>
        <div class="block-heading">
          <span id="telemetry-title" class="obs-eyebrow">Visitor telemetry // 来访信号 // 来訪計測</span>
        </div>
        <VisitorWidgets />
      </section>
    </section>
  </main>
</Layout>

<script>
  /* Hero parallax: layers drift at different depths behind the cursor.
     Uses the CSS `translate` property so it composes with hover transforms. */
  function bindHeroParallax() {
    const board = document.querySelector('.poster-board');
    if (!board) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(pointer: coarse)').matches) return;
    if (board.dataset.parallaxBound) return;
    board.dataset.parallaxBound = '1';

    const layers = Array.from(board.querySelectorAll('[data-depth]'));
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;

    function tick() {
      raf = requestAnimationFrame(() => {
        cx += (tx - cx) * 0.07;
        cy += (ty - cy) * 0.07;
        layers.forEach((l) => {
          const d = parseFloat(l.dataset.depth || '0');
          l.style.translate = `${(cx * d).toFixed(2)}px ${(cy * d).toFixed(2)}px`;
        });
        if (Math.abs(tx - cx) > 0.002 || Math.abs(ty - cy) > 0.002) tick();
        else raf = 0;
      });
    }

    board.addEventListener('mousemove', (e) => {
      const r = board.getBoundingClientRect();
      tx = (e.clientX - r.left) / r.width - 0.5;
      ty = (e.clientY - r.top) / r.height - 0.5;
      if (!raf) tick();
    }, { passive: true });

    board.addEventListener('mouseleave', () => {
      tx = 0;
      ty = 0;
      if (!raf) tick();
    });
  }

  /* Magnetic route slabs: pull toward the cursor, spring back on leave. */
  function bindMagnets() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(pointer: coarse)').matches) return;

    document.querySelectorAll('.poster-route').forEach((el) => {
      if (el.dataset.magnetBound) return;
      el.dataset.magnetBound = '1';
      let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
      const PULL = 9;

      function tick() {
        raf = requestAnimationFrame(() => {
          cx += (tx - cx) * 0.15;
          cy += (ty - cy) * 0.15;
          el.style.translate = `${cx.toFixed(2)}px ${cy.toFixed(2)}px`;
          if (Math.abs(tx - cx) > 0.02 || Math.abs(ty - cy) > 0.02) tick();
          else {
            raf = 0;
            if (tx === 0 && ty === 0) el.style.translate = '';
          }
        });
      }

      el.addEventListener('mousemove', (e) => {
        const r = el.getBoundingClientRect();
        tx = ((e.clientX - r.left) / r.width - 0.5) * PULL;
        ty = ((e.clientY - r.top) / r.height - 0.5) * PULL;
        if (!raf) tick();
      }, { passive: true });

      el.addEventListener('mouseleave', () => {
        tx = 0;
        ty = 0;
        if (!raf) tick();
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    bindHeroParallax();
    bindMagnets();
  });
  bindHeroParallax();
  bindMagnets();
</script>

<style>
  .home-page {
    min-height: 100%;
  }

  .poster-board {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(4.5rem, auto);
    min-height: min(980px, calc(100dvh - 10rem));
    border: var(--frame) solid var(--border);
    background:
      repeating-linear-gradient(90deg, transparent 0 calc(8.333% - 1px), var(--border-subtle) calc(8.333% - 1px) 8.333%),
      repeating-linear-gradient(0deg, transparent 0 4.5rem, var(--border-subtle) 4.5rem calc(4.5rem + 1px)),
      var(--surface);
    isolation: isolate;
    overflow: hidden;
  }

  .poster-board > * {
    min-width: 0;
  }

  .poster-board::before {
    content: "";
    position: absolute;
    inset: 8% -10% auto 45%;
    height: 28%;
    background: var(--blueprint-grid);
    transform: rotate(-18deg);
    transform-origin: center;
    pointer-events: none;
    z-index: 0;
  }

  .poster-kicker {
    grid-column: 1 / 8;
    grid-row: 1;
    align-self: start;
    padding: var(--space-sm) var(--space-md);
    background: var(--accent-lemon);
    color: var(--accent-cream);
  }

  .red-slab,
  .blue-slab {
    display: grid;
    place-items: center;
    color: var(--accent-cream);
    font-family: var(--font-slab);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.08em;
    text-transform: uppercase;
  }

  .red-slab {
    grid-column: 1 / 4;
    grid-row: 2 / 6;
    background: var(--accent-signal);
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    clip-path: polygon(0 0, 100% 0, 72% 100%, 0 84%);
  }

  .blue-slab {
    grid-column: 9 / 13;
    grid-row: 1 / 5;
    background: var(--surface-solid);
    color: var(--accent-ice);
    font-family: var(--font-slab);
    font-size: clamp(3.5rem, 10vw, 9rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    writing-mode: vertical-rl;
    clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 76%);
  }

  .poster-title-block {
    grid-column: 3 / 11;
    grid-row: 2 / 7;
    align-self: center;
    padding: var(--space-lg);
    background: var(--surface);
    border: var(--frame) solid var(--border);
    clip-path: polygon(0 0, calc(100% - 34px) 0, 100% 34px, 92% 100%, 0 100%);
  }

  .poster-code {
    display: block;
    margin-bottom: var(--space-md);
    color: var(--accent-signal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .poster-title-block h1 {
    max-width: min(9ch, 100%);
    overflow-wrap: break-word;
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 9.5rem);
    font-weight: 600;
  }

  .manifesto-block {
    grid-column: 7 / 11;
    grid-row: 6 / 9;
    align-self: stretch;
    padding: var(--space-lg);
    background: var(--accent-cream);
    border: 1px solid var(--border);
    border-left: var(--frame-lg) solid var(--accent-iris);
    /* cream plate stays light in both themes — pin ink, never theme-flipping text tokens */
    color: var(--accent-lemon);
  }

  .manifesto-block .axis-label,
  .manifesto-block .obs-stat,
  .manifesto-block .obs-eyebrow {
    color: var(--accent-lemon);
  }

  .manifesto-block p {
    margin-top: var(--space-md);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    line-height: 1.35;
    font-style: italic;
  }

  .poster-route {
    position: relative;
    display: grid;
    align-content: space-between;
    min-height: 12rem;
    padding: var(--space-md);
    isolation: isolate;
    overflow: hidden;
    transition:
      color var(--duration-fast) var(--ease-sharp);
  }

  .poster-route::before,
  .poster-route::after {
    content: "";
    position: absolute;
    inset: auto auto 0 0;
    z-index: -1;
    height: 0;
    pointer-events: none;
    transition: height var(--duration-base) var(--ease-editorial), width var(--duration-base) var(--ease-editorial);
  }

  .poster-route::before {
    width: 100%;
    background: var(--accent-iris);
    clip-path: none;
  }

  .poster-route > * {
    position: relative;
    z-index: 1;
  }

  .poster-route::after {
    right: 0;
    left: auto;
    width: 44%;
    background: var(--surface-solid);
    clip-path: polygon(32% 0, 100% 0, 100% 100%, 0 100%);
  }

  .poster-route span,
  .poster-route small {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .poster-route strong {
    display: block;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3.3vw, 3.25rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .poster-route:hover,
  .poster-route:focus-visible {
    transform: translate(-0.35rem, -0.35rem) rotate(-1deg);
    color: var(--accent-cream);
  }

  .poster-route:hover::before,
  .poster-route:focus-visible::before {
    height: 100%;
  }

  .poster-route:hover::after,
  .poster-route:focus-visible::after {
    height: 100%;
    width: 18%;
  }

  .poster-route:hover small,
  .poster-route:hover span,
  .poster-route:hover strong,
  .poster-route:focus-visible small,
  .poster-route:focus-visible span,
  .poster-route:focus-visible strong {
    color: var(--accent-cream);
  }

  /* Nord's iris is intentionally light: invert to ink text and an ice
     secondary slice so both hover planes keep accessible contrast. */
  :global(html[data-theme='nord']) .poster-route:hover,
  :global(html[data-theme='nord']) .poster-route:hover small,
  :global(html[data-theme='nord']) .poster-route:hover span,
  :global(html[data-theme='nord']) .poster-route:hover strong,
  :global(html[data-theme='nord']) .poster-route:focus-visible,
  :global(html[data-theme='nord']) .poster-route:focus-visible small,
  :global(html[data-theme='nord']) .poster-route:focus-visible span,
  :global(html[data-theme='nord']) .poster-route:focus-visible strong {
    color: var(--canvas);
  }

  :global(html[data-theme='nord']) .poster-route::after {
    background: var(--accent-ice);
  }

  .route-start {
    grid-column: 1 / 4;
    grid-row: 7 / 10;
    background: var(--accent-red);
    color: var(--accent-cream);
    clip-path: polygon(0 0, 100% 12%, 86% 100%, 0 100%);
  }

  .route-archive {
    grid-column: 4 / 7;
    grid-row: 8 / 11;
    background: var(--surface);
    clip-path: polygon(12% 0, 100% 0, 100% 88%, 0 100%, 0 16%);
  }

  .mode-block {
    grid-column: 10 / 13;
    grid-row: 5 / 8;
    align-self: stretch;
    display: grid;
    align-content: end;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--accent-navy);
    color: var(--accent-cream);
    clip-path: polygon(0 18%, 100% 0, 100% 100%, 12% 100%);
  }

  .mode-block .axis-label,
  .mode-block p,
  .mode-block strong {
    color: var(--accent-cream);
  }

  .mode-block strong {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 4rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }

  .dispatch-block {
    grid-column: 1 / 9;
    grid-row: 11 / 16;
    padding: var(--space-lg);
    background: var(--surface);
    border-top: var(--frame-lg) solid var(--accent-blue);
  }

  .telemetry-block {
    grid-column: 9 / 13;
    grid-row: 9 / 16;
    padding: var(--space-lg);
    background: var(--accent-cream);
    border-left: var(--frame-lg) solid var(--accent-red);
    color: var(--accent-lemon);
  }

  .telemetry-block > .block-heading .obs-eyebrow {
    color: var(--accent-lemon);
  }

  .block-heading {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .poster-post-grid {
    border-top: var(--frame) solid var(--border);
  }

  /* Kinetic hero title: words rise out of overflow masks, one accent word */
  .kinetic .kw {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: 0.09em;
    margin-bottom: -0.09em;
  }

  .kinetic .kw > span {
    display: inline-block;
    transform: translateY(112%);
    animation: kw-rise 0.85s var(--ease-editorial) forwards;
    animation-delay: calc(var(--i) * 95ms + 150ms);
  }

  .kw-accent > span {
    font-style: italic;
    color: var(--accent-iris);
  }

  @keyframes kw-rise {
    to {
      transform: translateY(0);
    }
  }

  /* Ghost section-mark: oversized serif § drifting behind the hero */
  .hero-ghost {
    position: absolute;
    top: -12%;
    right: -3%;
    z-index: -1;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(17rem, 38vw, 32rem);
    line-height: 1;
    color: var(--text-ghost);
    pointer-events: none;
    animation: ghost-drift 90s linear infinite;
  }

  @keyframes ghost-drift {
    to {
      rotate: 360deg;
    }
  }

  /* Parallax layers translate via the CSS `translate` property so it
     composes with hover transforms (transform + translate both apply). */
  [data-depth] {
    will-change: translate;
  }

  @media (prefers-reduced-motion: reduce) {
    .kinetic .kw > span {
      animation: none;
      transform: none;
    }

    .hero-ghost {
      animation: none;
    }
  }

  @media (max-width: 1100px) {
    .poster-board {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      min-height: auto;
    }

    .poster-kicker,
    .red-slab,
    .blue-slab,
    .poster-title-block,
    .manifesto-block,
    .route-start,
    .route-archive,
    .mode-block,
    .dispatch-block,
    .telemetry-block {
      grid-column: 1;
      grid-row: auto;
      clip-path: none;
    }

    .red-slab,
    .blue-slab {
      min-height: 8rem;
      writing-mode: horizontal-tb;
    }

    .poster-title-block h1 {
      font-size: clamp(3rem, 16vw, 6rem);
    }
  }
</style>
