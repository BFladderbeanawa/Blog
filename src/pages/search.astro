---
import Layout from '../layouts/Layout.astro';
import { Input } from '@/components/ui/input';
---

<Layout title="Search" description="Search the blog">
  <main class="narrow-shell search-page">
    <span class="axis-label">Search / live index</span>
    <h1>Search the archive</h1>
    <div class="search-container">
      <Input
        type="text"
        id="search-input"
        placeholder="Type at least two characters..."
        autofocus
        className="search-input-field rounded-none h-auto p-4 font-display font-black text-[clamp(1.5rem,5vw,3rem)] tracking-[-0.05em] bg-[var(--surface)] text-[var(--text-primary)] border-[length:var(--frame)] border-[var(--border)] focus-visible:bg-[var(--accent-lemon)] focus-visible:text-[#111] focus-visible:ring-0 shadow-none"
      />
      <ul id="search-results"></ul>
    </div>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  let posts = [];

  fetch('/search.json')
    .then((res) => {
      if (!res.ok) throw new Error(`Request failed: ${res.status}`);
      return res.json();
    })
    .then((data) => {
      posts = data;
    })
    .catch(() => {
      posts = [];
    });

  searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase();
    if (query.length < 2) {
      searchResults.innerHTML = '';
      return;
    }

    const filtered = posts.filter((post) =>
      post.title.toLowerCase().includes(query) ||
      post.description.toLowerCase().includes(query) ||
      (post.tags && post.tags.some((tag) => tag.toLowerCase().includes(query)))
    );

    searchResults.innerHTML = filtered.map((post) => `
      <li class="result-item">
        <a href="/blog/${post.slug || post.id}/" class="result-link">
          <div class="result-header">
            ${post.category ? `<span class="result-badge">${post.category}</span>` : ''}
            <span class="read-signal">Open report</span>
          </div>
          <h3>${post.title}</h3>
          <p>${post.description}</p>
          ${post.tags && post.tags.length > 0 ? `
            <div class="result-tags">
              ${post.tags.map((t) => `<span class="result-tag">#${t}</span>`).join('')}
            </div>
          ` : ''}
        </a>
      </li>
    `).join('');
  });
</script>

<style>
  .search-page h1 {
    margin: var(--space-lg) 0 var(--space-xl);
    font-size: var(--text-3xl);
  }

  input {
    width: 100%;
    padding: 1rem;
    border: var(--frame) solid var(--border);
    border-radius: 0;
    background: var(--surface);
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    outline: none;
  }

  input:focus {
    background: var(--accent-lemon);
    color: #111;
  }

  ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--space-md);
  }

  .result-item {
    border: var(--frame) solid var(--border);
    background: var(--surface);
    transition: transform var(--duration-fast) var(--ease-editorial);
  }

  .result-item:hover {
    transform: translate(-2px, -2px);
  }

  .result-link {
    display: block;
    padding: 1.25rem;
  }

  .result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .result-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--border);
    background: var(--canvas-inset);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .read-signal {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .result-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.85rem;
  }

  .result-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--border-subtle);
    background: var(--canvas);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  h3 {
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    margin: 0.25rem 0 0;
  }

  p {
    margin-top: 0.35rem;
    color: var(--text-secondary);
  }
</style>
