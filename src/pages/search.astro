---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search" description="Search the blog">
  <main class="narrow-shell search-page">
    <span class="obs-eyebrow">Search / live index</span>
    <h1>Search the archive</h1>
    <div class="search-container obs-frame obs-frame--powered">
      <span class="obs-id">QUERY</span>
      <input type="text" id="search-input" placeholder="Type at least two characters..." autofocus />
    </div>
    <ul id="search-results"></ul>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  let posts = [];

  fetch('/search.json')
    .then((res) => {
      if (!res.ok) throw new Error(`Request failed: ${res.status}`);
      return res.json();
    })
    .then((data) => {
      posts = data;
    })
    .catch(() => {
      posts = [];
    });

  searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase();
    if (query.length < 2) {
      searchResults.innerHTML = '';
      return;
    }

    const filtered = posts.filter((post) =>
      post.title.toLowerCase().includes(query) ||
      post.description.toLowerCase().includes(query) ||
      (post.tags && post.tags.some((tag) => tag.toLowerCase().includes(query)))
    );

    searchResults.innerHTML = filtered.map((post) => `
      <li>
        <a href="/blog/${post.slug}">
          <h3>${post.title}</h3>
          <p>${post.description}</p>
        </a>
      </li>
    `).join('');
  });
</script>

<style>
  .search-page h1 {
    margin: var(--space-lg) 0 var(--space-xl);
    font-size: var(--text-3xl);
  }

  .search-container {
    position: relative;
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  input {
    width: 100%;
    padding: 1rem;
    border: none;
    border-radius: 0;
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    outline: none;
  }

  input:focus {
    color: var(--accent-iris);
  }
</style>

<style is:global>
  /* Results are injected at runtime via innerHTML — scoped selectors
     never match them, so these rules must be global. */
  ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-xl);
    border-top: var(--frame) solid var(--border);
  }

  li a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.5rem;
    gap: var(--space-sm);
    align-items: center;
    padding: var(--space-md) var(--space-sm) var(--space-md) var(--space-md);
    border-bottom: 1px solid var(--border-subtle);
    transition: background-color var(--duration-fast) var(--ease-sharp);
  }

  li a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent-iris);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--duration-base) var(--ease-editorial);
  }

  li a:hover,
  li a:focus-visible {
    background: var(--accent-wash);
  }

  li a:hover::before,
  li a:focus-visible::before {
    transform: scaleY(1);
  }

  li a h3 {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  li a p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    overflow: hidden;
    margin-top: 0.2rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
</style>
