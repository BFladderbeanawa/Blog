---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search" description="Search the blog">
  <main class="narrow-shell search-page">
    <span class="axis-label">Search / live index</span>
    <h1>Search the archive</h1>
    <div class="search-container">
      <input type="text" id="search-input" placeholder="Type at least two characters..." autofocus />
      <ul id="search-results"></ul>
    </div>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  let posts = [];

  fetch('/search.json')
    .then((res) => {
      if (!res.ok) throw new Error(`Request failed: ${res.status}`);
      return res.json();
    })
    .then((data) => {
      posts = data;
    })
    .catch(() => {
      posts = [];
    });

  searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase();
    if (query.length < 2) {
      searchResults.innerHTML = '';
      return;
    }

    const filtered = posts.filter((post) =>
      post.title.toLowerCase().includes(query) ||
      post.description.toLowerCase().includes(query) ||
      (post.tags && post.tags.some((tag) => tag.toLowerCase().includes(query)))
    );

    searchResults.innerHTML = filtered.map((post) => `
      <li>
        <a href="/blog/${post.slug || post.id}/">
          <h3>${post.title}</h3>
          <p>${post.description}</p>
        </a>
      </li>
    `).join('');
  });
</script>

<style>
  .search-page h1 {
    margin: var(--space-lg) 0 var(--space-xl);
    font-size: var(--text-3xl);
  }

  input {
    width: 100%;
    padding: 1rem;
    border: var(--frame) solid var(--border);
    border-radius: 0;
    background: var(--surface);
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    outline: none;
  }

  input:focus {
    background: var(--accent-lemon);
    color: #111;
  }

  ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }

  li a {
    display: block;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  h3 {
    font-size: clamp(1.4rem, 3vw, 2.4rem);
  }

  p {
    margin-top: 0.35rem;
  }
</style>
