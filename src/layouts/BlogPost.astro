---
import Layout from './Layout.astro';
import Author from '../components/Author.astro';
import BlogNav from '../components/BlogNav.astro';
import { getCollection } from 'astro:content';

const { title, description, pubDate, updatedDate, heroImage, tags, category, readingMinutes } = Astro.props;

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const simplePosts = allPosts.map((p) => ({
  slug: p.slug,
  title: p.data.title,
  category: p.data.category,
  tags: p.data.tags || [],
}));
---

<Layout title={title} description={description}>
  <main class="post-page">
    <BlogNav tags={tags} />
    <article class="post-article">
      {heroImage && (
        <figure class="hero-image editorial-frame">
          <img width={1020} height={510} src={heroImage} alt="" />
        </figure>
      )}

      <header class="post-header editorial-frame">
        <span class="obs-id">LOG.ENTRY</span>
        <div class="post-date obs-stat">
          {pubDate && <time datetime={pubDate.toISOString()}><b>{pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}</b></time>}
          {updatedDate && <span>Updated <b>{updatedDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}</b></span>}
          {readingMinutes && <span>Read <b>~{readingMinutes} min</b></span>}
        </div>
        <h1>{title}</h1>
        <div id="back-nav" class="back-nav" style="display: none;">
          <a href="#" class="back-link">Back to archive</a>
        </div>
        <div class="taxon-row">
          {category && <a class="taxon" href={`/category/${category}/`}>{category}</a>}
          {tags && tags.map((tag) => <a class="taxon" href={`/tags?tags=${tag}`}>#{tag}</a>)}
        </div>
      </header>

      <div class="prose">
        <slot />
        <Author />

        <nav class="post-navigation" id="post-nav" style="display: none;">
          <a href="#" id="prev-post" class="nav-item prev obs-frame obs-hover">
            <span class="label">Newer</span>
            <span class="nav-title"></span>
          </a>
          <a href="#" id="next-post" class="nav-item next obs-frame obs-hover">
            <span class="label">Older</span>
            <span class="nav-title"></span>
          </a>
        </nav>
      </div>
    </article>
  </main>
</Layout>

<script define:vars={{ simplePosts }}>
  document.addEventListener('astro:page-load', () => {
    const backNav = document.getElementById('back-nav');
    const backLink = backNav ? backNav.querySelector('a') : null;
    let navContext = { type: 'all', data: '' };

    try {
      const saved = sessionStorage.getItem('blog_nav_context');
      if (saved) navContext = JSON.parse(saved);
    } catch (e) {}

    if (backNav && backLink) {
      let backUrl = '/blog';
      let backText = 'Back to all records';
      if (navContext.type === 'category' && navContext.data) {
        backUrl = `/category/${navContext.data}`;
        backText = `Back to category: ${navContext.data}`;
      } else if (navContext.type === 'tags' && navContext.data) {
        backUrl = `/tags?tags=${navContext.data}`;
        backText = `Back to tags: ${navContext.data}`;
      }
      backLink.href = backUrl;
      backLink.textContent = backText;
      backNav.style.display = 'block';
    }

    let relevantPosts = simplePosts;
    if (navContext.type === 'category' && navContext.data) {
      relevantPosts = simplePosts.filter((p) => p.category === navContext.data);
    } else if (navContext.type === 'tags' && navContext.data) {
      const filterTags = navContext.data.split(',');
      relevantPosts = simplePosts.filter((p) => p.tags.some((t) => filterTags.includes(t)));
    }

    const path = window.location.pathname;
    let currentIndex = relevantPosts.findIndex((p) => path.includes(`/blog/${p.slug}`));
    if (currentIndex === -1) {
      relevantPosts = simplePosts;
      currentIndex = relevantPosts.findIndex((p) => path.includes(`/blog/${p.slug}`));
    }

    if (currentIndex !== -1) {
      const nav = document.getElementById('post-nav');
      const prevLink = document.getElementById('prev-post');
      const nextLink = document.getElementById('next-post');
      const newerPost = relevantPosts[currentIndex - 1];
      const olderPost = relevantPosts[currentIndex + 1];

      if (newerPost) {
        prevLink.href = `/blog/${newerPost.slug}/`;
        prevLink.querySelector('.nav-title').textContent = newerPost.title;
        prevLink.style.display = 'grid';
      } else {
        prevLink.style.display = 'none';
      }

      if (olderPost) {
        nextLink.href = `/blog/${olderPost.slug}/`;
        nextLink.querySelector('.nav-title').textContent = olderPost.title;
        nextLink.style.display = 'grid';
      } else {
        nextLink.style.display = 'none';
      }

      if (newerPost || olderPost) nav.style.display = 'grid';
    }
  });
</script>

<style>
  .post-page {
    width: min(var(--page-width), 100%);
    margin: 0 auto;
    padding: var(--space-2xl) clamp(1rem, 4vw, 3rem) var(--space-3xl);
  }

  .post-article {
    display: grid;
    gap: var(--space-xl);
  }

  .hero-image {
    max-height: 34rem;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.12);
  }

  .post-header {
    padding: clamp(1rem, 4vw, 3rem);
    background: var(--surface);
  }

  .post-date,
  .taxon-row,
  .back-link,
  .label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .post-date {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--text-tertiary);
  }

  .post-header h1 {
    max-width: 12ch;
    margin: var(--space-xl) 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
  }

  .back-link {
    color: var(--text-tertiary);
  }

  .taxon-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-lg);
  }

  .taxon {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .taxon:hover {
    background: var(--accent-iris);
    color: var(--accent-cream);
  }

  .prose {
    width: min(var(--content-width), 100%);
    margin: 0 auto;
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.85;
  }

  /* Drop cap on the opening paragraph (首字下沉) */
  :global(.prose > p:first-of-type::first-letter) {
    float: left;
    padding: 0.06em 0.14em 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3.1em;
    line-height: 0.85;
    color: var(--accent-iris);
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin: 2.5rem 0 1rem;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 1rem 0;
  }

  .prose :global(a) {
    color: var(--accent-iris);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    color: var(--accent-signal);
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: var(--space-lg);
    border-left: 3px solid var(--accent-iris);
    background: var(--accent-wash);
    font-style: italic;
  }

  .prose :global(table) {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    border: 1px solid var(--border);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.85rem;
    border: 1px solid var(--border);
    text-align: left;
  }

  .post-navigation {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-2xl);
  }

  .nav-item {
    min-height: 9rem;
    padding: var(--space-md);
    align-content: space-between;
  }

  .nav-item.next {
    text-align: right;
  }

  .nav-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  /* Iris marks interactivity; the frame surface stays light in both themes,
     so the title must never flip to cream here. */
  .nav-item:hover .nav-title,
  .nav-item:focus-visible .nav-title {
    color: var(--accent-iris);
  }

  @media (max-width: 720px) {
    .post-navigation {
      grid-template-columns: 1fr;
    }
  }
</style>
