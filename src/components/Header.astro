---
const { pathname } = Astro.url;
const isActive = (path: string) => {
  if (path === '/') return pathname === '/';
  return pathname.startsWith(path);
};
---

<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label="BF home">
      <span class="brand-mark">BF</span>
      <span class="brand-copy">
        <span class="brand-title">BFladderbean</span>
        <span class="brand-subtitle">数字庭園 // デジタル庭 // Digital Garden</span>
      </span>
    </a>

    <div class="internal-links">
      <a href="/" class={isActive('/') ? 'active' : ''}><span class="nav-word">Home</span><span class="nav-caption">首頁</span></a>
      <a href="/start-here" class={isActive('/start-here') ? 'active' : ''}><span class="nav-word">Start</span><span class="nav-caption">開始</span></a>
      <a href="/blog" class={isActive('/blog') ? 'active' : ''}><span class="nav-word">Archive</span><span class="nav-caption">記録</span></a>
      <a href="/about" class={isActive('/about') ? 'active' : ''}><span class="nav-word">About</span><span class="nav-caption">自己</span></a>
    </div>

    <a class="search-link" href="/search" aria-label="Search">
      <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
      <span>Search<br /><small>検索</small></span>
    </a>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: var(--z-header);
    flex: 0 0 auto;
    border-bottom: var(--frame) solid var(--border);
    border-top: 3px solid var(--accent-iris);
    background: var(--surface);
  }

  .site-nav {
    display: grid;
    grid-template-columns: minmax(14rem, 1.1fr) minmax(0, 1.6fr) minmax(4.75rem, 0.2fr);
    align-items: end;
    gap: var(--space-sm);
    min-height: 6.75rem;
    padding: var(--space-sm) var(--space-md) 0;
  }

  .brand {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: end;
    min-width: 0;
    color: var(--text-primary);
    transform: translateY(var(--space-sm));
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 6.5rem;
    min-height: 6.1rem;
    border: var(--frame) solid var(--border);
    background: var(--surface-solid);
    color: var(--accent-cream);
    font-family: var(--font-slab);
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    clip-path: polygon(0 0, 100% 0, 76% 100%, 0 86%);
  }

  .brand-copy {
    display: grid;
    align-content: center;
    gap: 0.2rem;
    padding: var(--space-sm) var(--space-md);
    min-width: 0;
    border-block: var(--frame) solid var(--border);
    background: var(--surface);
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.75rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .brand-subtitle {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .internal-links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: end;
    gap: var(--space-xs);
    border-left: 0;
  }

  .internal-links a,
  .search-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 4.2rem;
    padding: 0.8rem 1rem;
    border: var(--frame) solid var(--border);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    line-height: 1.05;
    text-transform: uppercase;
    isolation: isolate;
    overflow: hidden;
    transition:
      color var(--duration-fast) var(--ease-sharp),
      transform var(--duration-base) var(--ease-editorial);
  }

  .internal-links a::before,
  .internal-links a::after,
  .search-link::before,
  .search-link::after {
    content: "";
    position: absolute;
    inset: auto auto 0 0;
    z-index: 0;
    height: 100%;
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-editorial);
  }

  .internal-links a::before,
  .search-link::before {
    width: 72%;
    background: var(--accent-iris);
    clip-path: polygon(0 0, 88% 0, 100% 100%, 0 100%);
  }

  .internal-links a > *,
  .search-link > * {
    position: relative;
    z-index: 1;
  }

  .internal-links a::after,
  .search-link::after {
    right: 0;
    left: auto;
    width: 38%;
    transform-origin: right;
    background: var(--accent-ice);
    clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%);
  }

  .internal-links .nav-caption,
  .search-link small {
    color: var(--text-tertiary);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
  }

  .internal-links a:hover,
  .internal-links a.active,
  .search-link:hover {
    color: var(--accent-cream);
    transform: translateY(-0.4rem) rotate(-1deg);
  }

  .internal-links a:hover::before,
  .internal-links a.active::before,
  .search-link:hover::before {
    transform: scaleX(1);
  }

  .internal-links a:hover::after,
  .internal-links a.active::after,
  .search-link:hover::after {
    transform: scaleX(1);
  }

  .internal-links a:hover .nav-caption,
  .internal-links a.active .nav-caption,
  .search-link:hover small {
    color: var(--accent-cream);
  }

  /* Node echo: the active cell's sub-label carries the vocabulary square */
  .internal-links a.active .nav-caption::before {
    content: "■";
    margin-right: 0.4em;
    font-size: 0.5rem;
    vertical-align: 0.08em;
  }

  .search-link {
    gap: 0.5rem;
    align-self: stretch;
    background: var(--surface-solid);
    color: var(--accent-cream);
    clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 82%);
    border: 1px solid var(--border-subtle);
  }

  .search-link:hover {
    border-color: var(--accent-iris);
  }

  .search-link small {
    color: var(--accent-cream);
  }

  .internal-links a { flex-direction: column; gap: 0.4rem; touch-action: manipulation; }
  .internal-links a:active, .search-link:active { transform: scale(0.98); transition-duration: 0s; }
  .internal-links a:focus-visible::before, .internal-links a:focus-visible::after,
  .search-link:focus-visible::before, .search-link:focus-visible::after { transform: scaleX(1); }
  .internal-links a:focus-visible, .internal-links a:focus-visible .nav-caption,
  .search-link:focus-visible { color: var(--accent-cream); }
  @media (prefers-reduced-motion: reduce) {
    .internal-links a:hover, .internal-links a.active, .internal-links a:active,
    .search-link:hover, .search-link:active { transform: none; }
  }

  @media (max-width: 840px) {
    .site-nav {
      grid-template-columns: 1fr auto;
      min-height: auto;
    }

    .brand-subtitle,
    .search-link span {
      display: none;
    }

    .internal-links {
      grid-column: 1 / -1;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow-x: auto;
      border-top: 1px solid var(--border);
      border-left: 0;
    }

    .internal-links a {
      min-width: 0;
    }

    .search-link {
      grid-column: 2;
      grid-row: 1;
      min-width: 3rem;
      border-left: 1px solid var(--border);
    }
  }
  @media (max-width: 600px) {
    .site-nav { padding: 0.5rem 0.75rem; gap: 0.5rem; }
    .brand { grid-template-columns: 3.5rem minmax(0, 1fr); transform: none; }
    .brand-mark { width: 3.5rem; min-height: 3.4rem; font-size: 2.25rem; border-width: 1px; }
    .brand-copy { padding: 0.6rem 0.5rem; border-width: 1px; }
    .brand-title { font-size: clamp(0.9rem, 4.5vw, 1.25rem); }
    .internal-links { padding-top: 0.5rem; gap: 0.4rem; }
    .internal-links a { min-height: 3rem; padding: 0.4rem 0.2rem; border-width: 1px; font-size: 0.62rem; gap: 0.3rem; }
    .internal-links .nav-caption { font-size: 0.52rem; }
    .internal-links a.active, .internal-links a:hover { transform: none; }
    .search-link { min-height: 3rem; padding: 0.6rem; clip-path: none; }
  }
</style>
