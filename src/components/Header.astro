---
import { Button } from '@/components/ui/button';
import { Search } from 'lucide-react';

const { pathname } = Astro.url;
const isActive = (path: string) => {
  if (path === '/') return pathname === '/';
  return pathname.startsWith(path);
};
---

<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label="BF home">
      <span class="brand-mark">BF</span>
      <span class="brand-copy">
        <span class="brand-title">BFladderbean</span>
        <span class="brand-subtitle">Digital Garden / Field Notes</span>
      </span>
    </a>

    <div class="internal-links">
      <Button variant="ghost" asChild className="rounded-none border-0 shadow-none p-0 h-auto">
        <a href="/" class={isActive('/') ? 'active' : ''}>Home</a>
      </Button>
      <Button variant="ghost" asChild className="rounded-none border-0 shadow-none p-0 h-auto">
        <a href="/start-here" class={isActive('/start-here') ? 'active' : ''}>Start</a>
      </Button>
      <Button variant="ghost" asChild className="rounded-none border-0 shadow-none p-0 h-auto">
        <a href="/blog" class={isActive('/blog') ? 'active' : ''}>Archive</a>
      </Button>
      <Button variant="ghost" asChild className="rounded-none border-0 shadow-none p-0 h-auto">
        <a href="/about" class={isActive('/about') ? 'active' : ''}>About</a>
      </Button>
    </div>

    <Button variant="ghost" asChild className="rounded-none border-0 shadow-none p-0 h-auto search-button-wrapper">
      <a class="search-link" href="/search" aria-label="Search">
        <Search className="size-[19px]" />
        <span>Search</span>
      </a>
    </Button>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: var(--z-header);
    flex: 0 0 auto;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
  }

  .site-nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: stretch;
    gap: 0;
    min-height: 4.35rem;
  }

  .brand {
    display: flex;
    align-items: stretch;
    min-width: 0;
    color: var(--text-primary);
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 4.35rem;
    border-right: 1px solid var(--border);
    background: var(--text-primary);
    color: var(--canvas);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: -0.06em;
  }

  .brand-copy {
    display: grid;
    align-content: center;
    gap: 0.2rem;
    padding: 0.65rem 1rem;
    min-width: 0;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.75rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  .brand-subtitle {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .internal-links {
    display: flex;
    border-left: 1px solid var(--border);
  }

  .internal-links a,
  .search-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 5.8rem;
    padding: 0.8rem 1rem;
    border-right: 1px solid var(--border);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background var(--duration-fast) var(--ease-sharp), color var(--duration-fast) var(--ease-sharp);
  }

  .internal-links a:hover,
  .internal-links a.active,
  .search-link:hover {
    background: var(--text-primary);
    color: var(--canvas);
  }

  .search-link {
    gap: 0.5rem;
    border-right: 0;
  }

  @media (max-width: 840px) {
    .site-nav {
      grid-template-columns: 1fr auto;
    }

    .brand-subtitle,
    .search-link span {
      display: none;
    }

    .internal-links {
      grid-column: 1 / -1;
      overflow-x: auto;
      border-top: 1px solid var(--border);
      border-left: 0;
    }

    .internal-links a {
      flex: 1 0 auto;
      min-width: 0;
      border-right: 1px solid var(--border);
    }

    .search-link {
      min-width: 4.35rem;
      border-left: 1px solid var(--border);
    }
  }
</style>
