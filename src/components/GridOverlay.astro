---
/**
 * GridOverlay — visible Cartesian surveying layer.
 */
const range = (min: number, max: number, step: number) =>
  Array.from({ length: Math.floor((max - min) / step) + 1 }, (_, index) => min + index * step);

const xMajorTicks = range(-800, 800, 100).filter((tick) => tick !== 0);
const yMajorTicks = range(-500, 500, 100).filter((tick) => tick !== 0);
const xMinorTicks = range(-850, 850, 50).filter((tick) => tick !== 0 && tick % 100 !== 0);
const yMinorTicks = range(-550, 550, 50).filter((tick) => tick !== 0 && tick % 100 !== 0);
---
<div class="grid-overlay" aria-hidden="true">
  <div class="grid-lines"></div>
  <div class="axis axis-x"></div>
  <div class="axis axis-y"></div>
  <span class="coord coord-x">X AXIS</span>
  <span class="coord coord-y">Y AXIS</span>
  <span id="coord-readout" class="coord-readout">X:0000 / Y:0000</span>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const readout = document.getElementById('coord-readout');
    if (!readout || (window as any).__bfCoordTelemetryBound) return;

    (window as any).__bfCoordTelemetryBound = true;
    window.addEventListener('mousemove', (event) => {
      const x = String(Math.round(event.clientX - window.innerWidth / 2)).padStart(4, '0');
      const y = String(Math.round(window.innerHeight / 2 - event.clientY)).padStart(4, '0');
      const target = document.getElementById('coord-readout');
      if (target) target.textContent = `X:${x} / Y:${y}`;
    }, { passive: true });
  });
</script>

<style>
  .grid-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: var(--z-grid);
    overflow: hidden;
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image:
      linear-gradient(var(--blueprint-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--blueprint-grid) 1px, transparent 1px);
    background-size: 32px 32px, 32px 32px;
    opacity: 1;
  }

  .schematic-field {
    position: absolute;
    z-index: 1;
    left: 7vw;
    top: 9vh;
    width: 86vw;
    height: 78vh;
    opacity: 0.34;
    background:
      radial-gradient(ellipse at 72% 30%, transparent 0 18%, color-mix(in srgb, var(--text-primary) 12%, transparent) 18.2% 18.5%, transparent 18.7% 30%, color-mix(in srgb, var(--text-primary) 9%, transparent) 30.2% 30.5%, transparent 30.8%),
      radial-gradient(ellipse at 34% 74%, transparent 0 24%, color-mix(in srgb, var(--accent-blue) 13%, transparent) 24.1% 24.4%, transparent 24.7% 39%, color-mix(in srgb, var(--text-primary) 8%, transparent) 39.2% 39.5%, transparent 39.8%),
      repeating-linear-gradient(33deg, transparent 0 34px, color-mix(in srgb, var(--text-primary) 7%, transparent) 34px 35px),
      repeating-linear-gradient(112deg, transparent 0 47px, color-mix(in srgb, var(--accent-blue) 9%, transparent) 47px 48px);
    clip-path: polygon(3% 9%, 72% 0, 100% 23%, 89% 88%, 22% 100%, 0 64%);
  }

  .schematic-field::before,
  .schematic-field::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .schematic-field::before {
    left: 12%;
    top: 22%;
    width: 68%;
    height: 46%;
    border: 1px solid color-mix(in srgb, var(--text-primary) 13%, transparent);
    border-left-color: transparent;
    transform: skewX(-18deg) rotate(-4deg);
  }

  .schematic-field::after {
    right: 8%;
    bottom: 10%;
    width: 44%;
    height: 32%;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--text-primary) 11%, transparent) 0 1px, transparent 1px),
      linear-gradient(color-mix(in srgb, var(--text-primary) 11%, transparent) 0 1px, transparent 1px);
    background-size: 18px 18px;
    transform: rotate(11deg);
  }

  .axis {
    position: absolute;
    z-index: 2;
    background: var(--axis);
    opacity: 0.92;
  }

  .axis-x {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }

  .axis-y {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }

  .axis-ticks {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .axis-tick {
    position: absolute;
    display: block;
    background: var(--axis);
    opacity: 0.84;
  }

  .tick-x {
    top: 50%;
    left: calc(50% + var(--tick-offset));
    width: 1px;
    transform: translateY(-50%);
  }

  .tick-y {
    top: calc(50% - var(--tick-offset));
    left: 50%;
    height: 1px;
    transform: translateX(-50%);
  }

  .tick-major.tick-x { height: 19px; }
  .tick-major.tick-y { width: 19px; }
  .tick-minor.tick-x { height: 7px; opacity: 0.48; }
  .tick-minor.tick-y { width: 7px; opacity: 0.48; }

  .tick-label {
    position: absolute;
    color: color-mix(in srgb, var(--text-primary) 58%, transparent);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tick-x .tick-label {
    top: 10px;
    left: 4px;
  }

  .tick-y .tick-label {
    top: -5px;
    left: 16px;
  }

  .survey-arc {
    position: absolute;
    z-index: 1;
    border: 1px solid var(--accent-blue);
    border-left-color: transparent;
    border-bottom-color: transparent;
    border-radius: 50%;
    opacity: 0.06;
  }

  .arc-a {
    display: none;
    left: calc(50% - 220px);
    top: calc(50% - 220px);
    width: 440px;
    height: 440px;
  }

  .arc-b {
    left: calc(50% - 330px);
    top: calc(50% - 330px);
    width: 660px;
    height: 660px;
    transform: rotate(30deg);
  }

  .arc-c {
    left: calc(50% + 110px);
    top: calc(50% - 390px);
    width: 720px;
    height: 720px;
    opacity: 0.045;
    transform: rotate(-18deg);
  }

  .arc-d {
    display: none;
    left: calc(50% - 650px);
    top: calc(50% + 80px);
    width: 560px;
    height: 560px;
    opacity: 0.045;
    transform: rotate(66deg);
  }

  .ghost-word {
    position: absolute;
    z-index: 1;
    color: var(--text-ghost);
    font-size: clamp(15rem, 27vw, 31rem);
    font-weight: 700;
    line-height: 1;
    opacity: 0.82;
    user-select: none;
  }

  .ghost-word::before,
  .ghost-word::after {
    content: "";
    position: absolute;
    background: color-mix(in srgb, var(--axis) 32%, transparent);
    pointer-events: none;
  }

  .ghost-word::before {
    left: -8vw;
    right: -8vw;
    top: 50%;
    height: 1px;
  }

  .ghost-word::after {
    top: -6vh;
    bottom: -6vh;
    left: 50%;
    width: 1px;
  }

  .word-the {
    left: 4vw;
    bottom: 6vh;
  }

  .word-coffs {
    right: -1vw;
    top: 4vh;
    transform: rotate(0deg);
  }

  /* Crosshairs */
  .crosshair {
    position: absolute;
    z-index: 2;
    width: 24px;
    height: 24px;
  }
  .crosshair .h-line {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--accent-blue);
    opacity: 0.35;
  }
  .crosshair .v-line {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    background: var(--accent-blue);
    opacity: 0.35;
  }
  .top-left     { top: 20px; left: 20px; }
  .top-right    { top: 20px; right: 20px; }
  .bottom-left  { bottom: 20px; left: 20px; }
  .bottom-right { bottom: 20px; right: 20px; }

  /* Calibration marks */
  .cal-mark {
    position: absolute;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-ghost);
    line-height: 1;
  }
  .cal-tl { top: 48px; left: 26px; }
  .cal-tr { top: 48px; right: 26px; }
  .cal-bl { bottom: 48px; left: 26px; }
  .cal-br { bottom: 48px; right: 26px; }

  /* Coordinate labels */
  .coord {
    position: absolute;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.25em;
    color: var(--accent-ice);
    text-transform: uppercase;
    opacity: 0.8;
  }
  .coord-x { top: calc(50% + 8px); right: 24px; }
  .coord-y { top: 24px; left: calc(50% + 8px); writing-mode: vertical-rl; }

  .coord-readout {
    position: absolute;
    z-index: 2;
    right: 24px;
    top: 24px;
    padding: 3px 6px;
    background: var(--surface-solid);
    border: 1px solid var(--border-subtle);
    color: var(--accent-iris);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .grid-lines { background-size: 32px 32px, 32px 32px; }
    .coord { display: none; }
    .axis-y { left: 24px; }
    .coord-readout {
      right: 8px;
      top: 8px;
      font-size: 8px;
    }
  }
</style>
