---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
---

<div class="author-bio obs-frame obs-frame--powered">
  <span class="obs-id">OBS.AUTHOR</span>
  <div class="avatar">
    <Image src={avatar} alt="BF" />
  </div>
  <div class="bio-content">
    <span class="obs-eyebrow">Author note</span>
    <h3>BFladderbean</h3>
    <p>Front-end developer, learner, and collector of technical field notes.</p>
    <a href="/about">Read the identity note</a>
  </div>
</div>

<style>
  .author-bio {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: center;
    margin-top: var(--space-2xl);
    padding: var(--space-lg);
  }

  .avatar {
    width: 6rem;
    aspect-ratio: 1;
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    background: var(--accent-lemon);
  }

  /* astro Image outputs width/height HTML attributes; a definite HTML
     height disables aspect-ratio, so height must be forced here. */
  .avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
  }

  .bio-content h3 {
    margin: 0.4rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.6rem);
    font-weight: 600;
  }

  .bio-content a {
    display: inline-flex;
    margin-top: 0.6rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 560px) {
    .author-bio {
      grid-template-columns: 1fr;
    }
  }
</style>
