---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { Card } from '@/components/ui/card';
import { AuthorAvatar } from './AuthorAvatar';
import { Button } from '@/components/ui/button';
---

<Card className="author-bio">
  <AuthorAvatar client:load src={avatar.src} alt="BF" className="avatar rounded-none border-0 size-auto" />
  <div class="bio-content">
    <span class="axis-label">Author note</span>
    <h3>BFladderbean</h3>
    <p>Front-end developer, learner, and collector of technical field notes.</p>
    <Button variant="link" asChild className="p-0 h-auto">
      <a href="/about">Read the identity note</a>
    </Button>
  </div>
</Card>

<style>
  .author-bio {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: center;
    margin-top: var(--space-2xl);
    padding: var(--space-lg);
    border: var(--frame) solid var(--border);
    background: var(--surface);
  }

  .avatar {
    border: 1px solid var(--border);
    overflow: hidden;
    background: var(--accent-lemon);
  }

  .avatar img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
  }

  .bio-content h3 {
    margin: 0.4rem 0;
    font-size: clamp(1.5rem, 4vw, 2.6rem);
  }

  .bio-content a {
    display: inline-flex;
    margin-top: 0.6rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 560px) {
    .author-bio {
      grid-template-columns: 1fr;
    }

    .avatar {
      width: 6rem;
    }
  }
</style>
