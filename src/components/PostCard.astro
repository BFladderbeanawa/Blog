---
import { Card } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';

const { post, highlightTags = [] } = Astro.props;

const formattedDate = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Card className="p-0 border-0 shadow-none rounded-none bg-transparent">
  <a
    href={`/blog/${post.id}/`}
    class="post-card"
    data-slug={post.id}
    data-tags={post.data.tags?.join(',') || ''}
    data-category={post.data.category || ''}
  >
    <Badge variant="outline" className="card-index">{formattedDate}</Badge>
    <div class="card-main">
      <div class="card-topline">
        {post.data.category && (
          <Badge variant="secondary" className="category">{post.data.category}</Badge>
        )}
        <Badge variant="outline" className="read-signal">Open report</Badge>
      </div>
      <h4 class="title">{post.data.title}</h4>
      <p class="description">{post.data.description}</p>
    </div>

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="mini-tags">
        {post.data.tags.map((t: string) => (
          <Badge variant="outline" className={`mini-tag ${highlightTags.includes(t) ? 'highlight' : ''}`}>#{t}</Badge>
        ))}
      </div>
    )}
  </a>
</Card>

<script>
  document.querySelectorAll('.post-card').forEach((card) => {
    card.addEventListener('click', () => {
      const url = new URL(window.location.href);
      let context = 'all';
      let contextData = '';

      if (url.pathname.includes('/category/')) {
        context = 'category';
        const parts = url.pathname.split('/');
        contextData = parts[parts.indexOf('category') + 1] || '';
      } else if (url.pathname.includes('/tags')) {
        context = 'tags';
        contextData = url.searchParams.get('tags') || '';
      }

      sessionStorage.setItem('blog_nav_context', JSON.stringify({ type: context, data: contextData }));
    });
  });
</script>

<style>
  .post-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 17rem;
    padding: 1rem;
    overflow: hidden;
    background:
      linear-gradient(135deg, transparent 0 48%, var(--guide-line) 48% 49%, transparent 49%),
      var(--surface);
    border: var(--frame) solid var(--border);
    color: var(--text-primary);
    isolation: isolate;
    transition: transform var(--duration-base) var(--ease-editorial), background var(--duration-fast) var(--ease-sharp);
  }

  .post-card::before {
    content: "";
    position: absolute;
    inset: auto 0 0 auto;
    width: 38%;
    height: 0.7rem;
    background: rgb(var(--accent));
    transform: translateX(102%);
    transition: transform var(--duration-base) var(--ease-editorial);
    z-index: -1;
  }

  .post-card::after {
    content: "READ";
    position: absolute;
    right: 0.8rem;
    top: 0.8rem;
    color: var(--text-ghost);
    font-family: var(--font-display);
    font-size: clamp(3rem, 12vw, 8rem);
    font-weight: 900;
    line-height: 0.75;
    letter-spacing: -0.08em;
    pointer-events: none;
  }

  .post-card:hover {
    transform: translate(-0.25rem, -0.25rem);
    color: var(--text-primary);
  }

  .post-card:hover::before {
    transform: translateX(0);
  }

  .card-index {
    width: fit-content;
    margin-bottom: var(--space-xl);
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--border);
    background: var(--canvas);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .card-main {
    position: relative;
    z-index: 1;
    align-self: end;
  }

  .card-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.7rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .title {
    margin: 0;
    font-size: clamp(1.45rem, 3vw, 2.4rem);
    line-height: 0.95;
  }

  .description {
    display: -webkit-box;
    margin-top: 0.8rem;
    max-width: 34rem;
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .mini-tags {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-self: end;
    margin-top: var(--space-lg);
  }

  .mini-tag {
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--border-subtle);
    background: var(--canvas);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .mini-tag.highlight {
    border-color: var(--border);
    background: rgb(var(--accent));
    color: #fffef8;
  }

  :global(.post-grid.compact-view) {
    grid-template-columns: 1fr !important;
    gap: 0 !important;
  }

  :global(.compact-view) .post-card {
    grid-template-columns: 12rem minmax(0, 1fr) auto;
    align-items: center;
    min-height: 0;
    padding: 0;
    border-width: 0 0 1px;
    background: transparent;
  }

  :global(.compact-view) .post-card::after,
  :global(.compact-view) .description,
  :global(.compact-view) .mini-tags {
    display: none;
  }

  :global(.compact-view) .card-index {
    margin: 0;
    border-width: 0 1px 0 0;
    padding: 1rem;
    background: transparent;
  }

  :global(.compact-view) .card-main {
    align-self: center;
    padding: 1rem;
  }

  :global(.compact-view) .title {
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }

  :global(.compact-view) .card-topline {
    margin-bottom: 0.35rem;
  }

  @media (max-width: 720px) {
    .post-card {
      min-height: 15rem;
    }

    :global(.compact-view) .post-card {
      grid-template-columns: 1fr;
      padding: 1rem 0;
    }

    :global(.compact-view) .card-index {
      border: 1px solid var(--border-subtle);
      margin: 0 1rem 0.5rem;
      width: fit-content;
      padding: 0.2rem 0.45rem;
    }
  }
</style>
