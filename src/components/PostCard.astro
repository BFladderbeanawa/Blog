---
const { post, highlightTags = [] } = Astro.props;

const formattedDate = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={`/blog/${post.id}/`}
  class="post-card"
  data-slug={post.id}
  data-tags={post.data.tags?.join(',') || ''}
  data-category={post.data.category || ''}
>
  <div class="row-meta">
    <span class="rec-no" aria-hidden="true"></span>
    <time class="row-date" datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
    {post.data.category && <span class="row-cat">{post.data.category}</span>}
  </div>
  <div class="row-main">
    <h4 class="title">{post.data.title}</h4>
    <p class="description">{post.data.description}</p>
    {highlightTags.length > 0 && post.data.tags && post.data.tags.length > 0 && (
      <div class="mini-tags">
        {post.data.tags.map((t) => (
          <span class={`mini-tag ${highlightTags.includes(t) ? 'highlight' : ''}`}>#{t}</span>
        ))}
      </div>
    )}
  </div>
  <span class="row-arrow" aria-hidden="true">→</span>
</a>

<script>
  document.querySelectorAll('.post-card').forEach((card) => {
    card.addEventListener('click', () => {
      const url = new URL(window.location.href);
      let context = 'all';
      let contextData = '';

      if (url.pathname.includes('/category/')) {
        context = 'category';
        const parts = url.pathname.split('/');
        contextData = parts[parts.indexOf('category') + 1] || '';
      } else if (url.pathname.includes('/tags')) {
        context = 'tags';
        contextData = url.searchParams.get('tags') || '';
      }

      sessionStorage.setItem('blog_nav_context', JSON.stringify({ type: context, data: contextData }));
    });
  });
</script>

<style>
  /* Registry row: REC-no | date | title+description | category | arrow.
     Desktop: .row-meta children are promoted to grid columns via display:contents;
     mobile: .row-meta collapses into one mono metadata line. */
  .post-card {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem 7.5rem minmax(0, 1fr) auto 2rem;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-md) var(--space-sm) var(--space-md) var(--space-md);
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-primary);
    transition: background-color var(--duration-fast) var(--ease-sharp);
  }

  .post-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent-iris);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--duration-base) var(--ease-editorial);
  }

  .post-card:hover,
  .post-card:focus-visible {
    background: var(--accent-wash);
  }

  .post-card:hover::before,
  .post-card:focus-visible::before {
    transform: scaleY(1);
  }

  .row-meta {
    display: contents;
  }

  .rec-no {
    grid-column: 1;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    transition: color var(--duration-fast) var(--ease-sharp);
  }

  .rec-no::before {
    counter-increment: obs-rec;
    content: "REC-" counter(obs-rec, decimal-leading-zero);
  }

  .post-card:hover .rec-no,
  .post-card:focus-visible .rec-no {
    color: var(--accent-iris);
  }

  .row-date {
    grid-column: 2;
    align-self: stretch;
    display: flex;
    align-items: center;
    padding-right: var(--space-sm);
    border-right: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .row-cat {
    grid-column: 4;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .row-main {
    grid-column: 3;
    min-width: 0;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    overflow-wrap: break-word;
  }

  .description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    overflow: hidden;
    margin-top: 0.2rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .row-arrow {
    grid-column: 5;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--text-tertiary);
    text-align: right;
    transition:
      color var(--duration-fast) var(--ease-sharp),
      transform var(--duration-base) var(--ease-editorial);
  }

  .post-card:hover .row-arrow,
  .post-card:focus-visible .row-arrow {
    color: var(--accent-iris);
    transform: translateX(3px);
  }

  .mini-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: 0.35rem;
  }

  .mini-tag {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
  }

  .mini-tag.highlight {
    border-color: var(--accent-iris);
    color: var(--accent-iris);
  }

  /* Density toggle: compact strips the description for single-line ledger rows */
  :global(.compact-view) .post-card {
    grid-template-columns: 4.5rem 7.5rem minmax(0, 1fr) auto 2rem;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-xs) var(--space-sm) var(--space-md);
  }

  :global(.compact-view) .description,
  :global(.compact-view) .mini-tags {
    display: none;
  }

  :global(.compact-view) .title {
    font-size: 1.02rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 760px) {
    .post-card {
      grid-template-columns: minmax(0, 1fr) 1.5rem;
      gap: 0.3rem var(--space-sm);
      padding: var(--space-sm) var(--space-xs) var(--space-sm) var(--space-md);
      align-items: start;
    }

    .row-meta {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      grid-column: 1;
    }

    .rec-no,
    .row-date,
    .row-cat {
      grid-column: auto;
      align-self: auto;
      border-right: 0;
      padding-right: 0;
    }

    .row-date {
      display: inline;
    }

    .row-main {
      grid-column: 1;
    }

    .row-arrow {
      grid-column: 2;
      align-self: center;
    }
  }
</style>
