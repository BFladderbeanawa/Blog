---
import { Button } from '@/components/ui/button';
import { StatusDrawer } from './StatusDrawer';

const today = new Date();
---

<footer class="site-footer">
  <div class="footer-strip" aria-hidden="true">
    <div class="marquee-track">
      <span>BFladderbean</span>
      <span>Field Notes</span>
      <span>Digital Garden</span>
      <span>Archive</span>
      <span>Signal Online</span>
      <span>System Active</span>
      <span>BFladderbean</span>
      <span>Field Notes</span>
      <span>Digital Garden</span>
      <span>Archive</span>
      <span>Signal Online</span>
      <span>System Active</span>
    </div>
  </div>

  <div class="footer-main">
    <div class="footer-left">
      <div class="social-links">
        <Button variant="ghost" size="icon" asChild className="rounded-none border-0 shadow-none p-0 size-auto">
          <a href="https://github.com/BFladderbeanawa" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <span class="sr-only">GitHub</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.44 5.44 0 0 0 3.5 8.55c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          </a>
        </Button>
        <Button variant="ghost" size="icon" asChild className="rounded-none border-0 shadow-none p-0 size-auto">
          <a href="https://space.bilibili.com/499560971" target="_blank" rel="noopener noreferrer" aria-label="Bilibili">
            <span class="sr-only">Bilibili</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><rect x="2" y="7" width="20" height="15"></rect><path d="m17 2-5 5-5-5"></path></svg>
          </a>
        </Button>
      </div>
      <p class="copyright">&copy; {today.getFullYear()} BFladderbean. <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener noreferrer">MIT License</a>.</p>
    </div>

    <StatusDrawer client:load />
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-header);
    flex: 0 0 auto;
    border-top: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
  }

  .footer-strip {
    display: flex;
    width: 100%;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    background: var(--text-primary);
    color: var(--canvas);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 2.2rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  .footer-strip span {
    flex: 0 0 auto;
    padding: 0.45rem 1.2rem 0.65rem;
  }

  .footer-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: 0.85rem 1rem;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .social-links {
    display: flex;
    border: 1px solid var(--border);
  }

  .social-links a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-right: 1px solid var(--border);
  }

  .social-links a:last-child {
    border-right: 0;
  }

  .social-links a:hover,
  .status-trigger:hover,
  .close-btn:hover {
    background: var(--text-primary);
    color: var(--canvas);
  }

  .copyright {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.72rem 1rem;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pulse-dot {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--accent-green);
  }
  @media (max-width: 720px) {
    .footer-main,
    .footer-left {
      align-items: stretch;
      flex-direction: column;
    }

    .status-trigger {
      justify-content: center;
    }
  }
</style>
