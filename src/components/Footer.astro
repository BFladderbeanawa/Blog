---
const today = new Date();
---

<footer class="site-footer">
  <div class="footer-strip" aria-hidden="true">
    <div class="marquee-track">
      <span>IRIS OBSERVATORY / 觀測記録 / DIGITAL GARDEN</span>
      <span>IRIS OBSERVATORY / 觀測記録 / DIGITAL GARDEN</span>
      <span>IRIS OBSERVATORY / 觀測記録 / DIGITAL GARDEN</span>
      <span>IRIS OBSERVATORY / 觀測記録 / DIGITAL GARDEN</span>
    </div>
  </div>

  <div class="footer-main">
    <div class="footer-left">
      <div class="social-links">
        <a href="https://github.com/BFladderbeanawa" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <span class="sr-only">GitHub</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.44 5.44 0 0 0 3.5 8.55c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        </a>
        <a href="https://space.bilibili.com/499560971" target="_blank" rel="noopener noreferrer" aria-label="Bilibili">
          <span class="sr-only">Bilibili</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><rect x="2" y="7" width="20" height="15"></rect><path d="m17 2-5 5-5-5"></path></svg>
        </a>
      </div>
      <p class="copyright">&copy; {today.getFullYear()} BFladderbean. <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener noreferrer">MIT License</a>.</p>
    </div>

    <button id="status-trigger" class="status-trigger" aria-label="Show status">
      <span class="pulse-dot"></span>
      <span>Live Status // 信号</span>
    </button>
  </div>

  <div id="status-overlay" class="status-overlay"></div>
  <aside id="status-drawer" class="status-drawer obs-frame" aria-hidden="true">
    <span class="obs-id">SYS.STATUS</span>
    <div class="drawer-header">
      <span class="obs-eyebrow">Current Signal // 現在信号 // 在线状态</span>
      <button id="close-drawer" class="close-btn" aria-label="Close">X</button>
    </div>
    <div class="status-card-inner">
      <h3 id="status-app" class="status-app">Loading...</h3>
      <p class="status-subtitle">Device and presence telemetry</p>
      <div class="status-items">
        <div class="status-item obs-stat"><span>Battery</span><strong id="status-battery">--</strong></div>
        <div class="status-item obs-stat"><span>Network</span><strong id="status-wifi">--</strong></div>
        <div class="status-item obs-stat"><span>City</span><strong id="status-city">--</strong></div>
        <div class="status-item obs-stat"><span>Model</span><strong id="status-model">--</strong></div>
      </div>
    </div>
  </aside>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-header);
    flex: 0 0 auto;
    border-top: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
  }

  .footer-strip {
    display: flex;
    width: 100%;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    background: var(--accent-red);
    color: var(--accent-cream);
    font-family: var(--font-macro);
    font-size: clamp(1.2rem, 3vw, 2.2rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .footer-strip span {
    flex: 0 0 auto;
    padding: 0.45rem 1.2rem 0.65rem;
  }

  .footer-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: 0.85rem 1rem;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .social-links {
    display: flex;
    border: 1px solid var(--border);
  }

  .social-links a {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-right: 1px solid var(--border);
    isolation: isolate;
    overflow: hidden;
  }

  .social-links a::before,
  .status-trigger::before,
  .close-btn::before {
    content: "";
    position: absolute;
    inset: auto 0 0;
    z-index: 0;
    height: 0;
    background: linear-gradient(112deg, var(--accent-red) 0 62%, var(--accent-blue) 62% 100%);
    transition: height var(--duration-base) var(--ease-editorial);
  }

  .social-links a > *,
  .status-trigger > *,
  .close-btn > * {
    position: relative;
    z-index: 1;
  }

  .social-links a:last-child {
    border-right: 0;
  }

  .social-links a:hover,
  .status-trigger:hover,
  .close-btn:hover {
    color: var(--accent-cream);
  }

  .social-links a:hover::before,
  .status-trigger:hover::before,
  .close-btn:hover::before {
    height: 100%;
  }

  .copyright {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.72rem 1rem;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    isolation: isolate;
    overflow: hidden;
  }

  .pulse-dot {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--accent-red);
  }

  .status-overlay {
    position: fixed;
    inset: 0;
    z-index: 998;
    visibility: hidden;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-editorial);
  }

  .status-overlay.active {
    visibility: visible;
    opacity: 1;
  }

  .status-drawer {
    position: fixed;
    top: 0;
    right: -31rem;
    z-index: 999;
    width: min(30rem, 100vw);
    height: 100vh;
    padding: var(--space-lg);
    border-left: var(--frame) solid var(--border);
    background: var(--surface);
    transition: right var(--duration-base) var(--ease-editorial);
  }

  .status-drawer.active {
    right: 0;
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .close-btn {
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-mono);
    isolation: isolate;
    overflow: hidden;
  }

  .status-app {
    margin-top: var(--space-xl);
    font-size: clamp(2.5rem, 8vw, 5rem);
  }

  .status-subtitle {
    margin: 0.5rem 0 var(--space-lg);
  }

  .status-items {
    display: grid;
    border-top: 1px solid var(--border);
  }

  .status-item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .footer-main,
    .footer-left {
      align-items: stretch;
      flex-direction: column;
    }

    .status-trigger {
      justify-content: center;
    }

    .status-drawer {
      right: -105vw;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const trigger = document.getElementById('status-trigger');
    const drawer = document.getElementById('status-drawer');
    const overlay = document.getElementById('status-overlay');
    const closeBtn = document.getElementById('close-drawer');

    function openDrawer() {
      drawer?.classList.add('active');
      overlay?.classList.add('active');
    }

    function closeDrawerAction() {
      drawer?.classList.remove('active');
      overlay?.classList.remove('active');
    }

    trigger?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawerAction);
    overlay?.addEventListener('click', closeDrawerAction);

    fetch('https://status-api.fannbryan.workers.dev/')
      .then((response) => response.json())
      .then((data) => {
        const appEl = document.getElementById('status-app');
        if (!appEl) return;

        appEl.textContent = data.app || 'Online';
        const battery = data['battery '] || data.battery || '--';
        document.getElementById('status-battery').textContent = String(battery).trim() + '%';
        const isConnected = data.wifi && data.wifi !== 'Not Connected';
        document.getElementById('status-wifi').textContent = isConnected ? 'Connected' : 'Offline';
        document.getElementById('status-city').textContent = data.city || '--';
        document.getElementById('status-model').textContent = data.model || '--';
      })
      .catch(() => {
        const appEl = document.getElementById('status-app');
        if (appEl) appEl.textContent = 'Offline';
      });
  });
</script>
