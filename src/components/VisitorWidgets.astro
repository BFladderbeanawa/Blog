---
import { Card } from '@/components/ui/card';
---

<div class="widgets-wrapper">
  <Card className="widget-card counter-card">
    <span class="axis-label">Visitor count</span>
    <div class="counter-content">
      <div class="count-item">
        <span class="label">Total page views</span>
        <span id="busuanzi_value_site_pv" class="count-num"><i class="loading">...</i></span>
      </div>
      <div class="count-item">
        <span class="label">Unique visitors</span>
        <span id="busuanzi_value_site_uv" class="count-num"><i class="loading">...</i></span>
      </div>
    </div>
  </Card>

  <Card className="widget-card map-card">
    <span class="axis-label">Visitor map</span>
    <div class="map-container">
      <script type="text/javascript" id="mapmyvisitors" src="//mapmyvisitors.com/map.js?d=GfWaagulw5y8ePx2r-A54yQmg5UIATp6pJDDcwAta44&cl=ffffff&w=a"></script>
      <div class="map-placeholder" style="display:none;">
        <p>Map loading...</p>
      </div>
    </div>
  </Card>
</div>

<script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>

<style>
  .widgets-wrapper {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .widget-card {
    min-height: 16rem;
    padding: var(--space-lg);
    border: var(--frame) solid var(--border);
    background: var(--surface);
  }

  .counter-card {
    background: var(--accent-lemon);
  }

  .map-card {
    background: var(--accent-gray);
  }

  .widget-card .axis-label,
  .counter-card .label,
  .counter-card .count-num,
  .map-card .axis-label {
    color: #111;
  }

  .counter-content {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .count-item {
    display: grid;
    gap: 0.4rem;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .count-num {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  .loading {
    font-style: normal;
  }

  .map-container {
    display: grid;
    place-items: center;
    min-height: 12rem;
    margin-top: var(--space-lg);
    overflow: hidden;
    border: 1px solid #111;
    background: #fffef8;
  }

  @media (max-width: 820px) {
    .widgets-wrapper {
      grid-template-columns: 1fr;
    }
  }
</style>
